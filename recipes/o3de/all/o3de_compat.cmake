# Targets that exist outside this file: the framework libraries and the 3rdParty targets.
# conan_component is the Conan component (or "pkg::component" requirement) they map to.
function(o3de_register_external target conan_component)
  set_property(TARGET ${target} PROPERTY O3DE_CONAN_COMPONENT "${conan_component}")
endfunction()

# 3rdParty::<name> from Conan targets; requires are the matching Conan requirements.
function(o3de_add_3rdparty name)
  cmake_parse_arguments(arg "" "" "TARGETS;REQUIRES;INCLUDE_DIRECTORIES;COMPILE_DEFINITIONS" ${ARGN})
  add_library(3rdParty::${name} INTERFACE IMPORTED GLOBAL)
  if(arg_TARGETS)
    set_property(TARGET 3rdParty::${name} PROPERTY INTERFACE_LINK_LIBRARIES ${arg_TARGETS})
  endif()
  if(arg_INCLUDE_DIRECTORIES)
    set_property(TARGET 3rdParty::${name} PROPERTY INTERFACE_INCLUDE_DIRECTORIES ${arg_INCLUDE_DIRECTORIES})
  endif()
  if(arg_COMPILE_DEFINITIONS)
    set_property(TARGET 3rdParty::${name} PROPERTY INTERFACE_COMPILE_DEFINITIONS ${arg_COMPILE_DEFINITIONS})
  endif()
  set_property(TARGET 3rdParty::${name} PROPERTY O3DE_CONAN_COMPONENT "${arg_REQUIRES}")
  # Headers of a library vendored in the O3DE tree are installed with the package.
  set_property(TARGET 3rdParty::${name} PROPERTY O3DE_INSTALL_INCLUDES "${arg_INCLUDE_DIRECTORIES}")
endfunction()

# Gem discovery: engine.json and every gem.json list their subdirectories.
function(o3de_discover_gems dir)
  foreach(manifest engine.json gem.json)
    if(EXISTS "${dir}/${manifest}")
      file(READ "${dir}/${manifest}" json)
      if(manifest STREQUAL "gem.json")
        cmake_path(NORMAL_PATH dir)
        string(REGEX REPLACE "/$" "" dir "${dir}")
        string(JSON gem_name GET "${json}" gem_name)
        set_property(GLOBAL PROPERTY "@GEMROOT:${gem_name}@" "${dir}")
        set_property(GLOBAL APPEND PROPERTY O3DE_ALL_GEMS ${gem_name})
        string(JSON deps_count ERROR_VARIABLE err LENGTH "${json}" dependencies)
        set(deps)
        if(NOT err)
          math(EXPR last "${deps_count} - 1")
          if(last GREATER_EQUAL 0)
            foreach(i RANGE ${last})
              string(JSON dep GET "${json}" dependencies ${i})
              # Version specifiers, e.g. "Atom_RPI>=1.0"
              string(REGEX REPLACE "[<>=~].*$" "" dep "${dep}")
              list(APPEND deps ${dep})
            endforeach()
          endif()
        endif()
        set_property(GLOBAL PROPERTY "O3DE_GEM_DEPENDENCIES_${gem_name}" "${deps}")
      endif()
      string(JSON subdir_count ERROR_VARIABLE err LENGTH "${json}" external_subdirectories)
      if(NOT err AND subdir_count GREATER 0)
        math(EXPR last "${subdir_count} - 1")
        foreach(i RANGE ${last})
          string(JSON subdir GET "${json}" external_subdirectories ${i})
          o3de_discover_gems("${dir}/${subdir}")
        endforeach()
      endif()
    endif()
  endforeach()
endfunction()

# Adds the selected Gems and the Gems they depend on.
function(o3de_add_gems)
  set(queue ${ARGN})
  set(selected)
  while(queue)
    list(POP_FRONT queue gem)
    if(gem IN_LIST selected)
      continue()
    endif()
    get_property(gem_root GLOBAL PROPERTY "@GEMROOT:${gem}@")
    if(NOT gem_root)
      message(FATAL_ERROR "Unknown Gem '${gem}'")
    endif()
    list(APPEND selected ${gem})
    get_property(deps GLOBAL PROPERTY "O3DE_GEM_DEPENDENCIES_${gem}")
    list(APPEND queue ${deps})
  endwhile()
  list(SORT selected)
  message(STATUS "O3DE Gems: ${selected}")
  # Atom_Utils is not a Gem of its own: the Atom Gem's CMakeLists.txt adds it, and the other
  # Atom Gems use it.
  if(NOT "Atom" IN_LIST selected AND "Atom_RPI" IN_LIST selected)
    add_subdirectory("${O3DE_ROOT}/Gems/Atom/Utils" "${CMAKE_BINARY_DIR}/o3de/Gems/Atom/Utils")
  endif()
  set_property(GLOBAL PROPERTY O3DE_SELECTED_GEMS ${selected})
  foreach(gem IN LISTS selected)
    get_property(gem_root GLOBAL PROPERTY "@GEMROOT:${gem}@")
    # Upstream adds every Gem from the engine's list, the ones nested in another Gem's directory
    # (Atom_RHI in Atom) included; skip one a parent Gem's CMakeLists.txt has added already.
    get_property(added_gem_roots GLOBAL PROPERTY O3DE_ADDED_GEM_ROOTS)
    if(gem_root IN_LIST added_gem_roots)
      continue()
    endif()
    file(RELATIVE_PATH rel "${O3DE_ROOT}" "${gem_root}")
    add_subdirectory("${gem_root}" "${CMAKE_BINARY_DIR}/o3de/${rel}")
  endforeach()
endfunction()

function(o3de_find_ancestor_gem_root out_path out_name dir)
  set(${out_path} "" PARENT_SCOPE)
  set(${out_name} "" PARENT_SCOPE)
  while(dir AND NOT dir STREQUAL O3DE_ROOT)
    if(EXISTS "${dir}/gem.json")
      file(READ "${dir}/gem.json" json)
      string(JSON name GET "${json}" gem_name)
      set(${out_path} "${dir}" PARENT_SCOPE)
      set(${out_name} "${name}" PARENT_SCOPE)
      return()
    endif()
    cmake_path(GET dir PARENT_PATH parent)
    if(parent STREQUAL dir)
      break()
    endif()
    set(dir "${parent}")
  endwhile()
endfunction()

macro(o3de_gem_setup)
  o3de_find_ancestor_gem_root(gem_path gem_name "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT gem_name)
    set(gem_name "${ARGV0}")
    set(gem_path "${CMAKE_CURRENT_SOURCE_DIR}")
  endif()
  set(gem_json "${gem_path}/gem.json")
  set_property(GLOBAL APPEND PROPERTY O3DE_ADDED_GEM_ROOTS "${gem_path}")
  file(READ "${gem_json}" _o3de_gem_json)
  string(JSON gem_version ERROR_VARIABLE _o3de_err GET "${_o3de_gem_json}" version)
  if(_o3de_err)
    set(gem_version "0.0.0")
  endif()
  set(gem_restricted_path "${gem_path}/restricted")
  set(gem_parent_relative_path "")
  set(pal_dir "${CMAKE_CURRENT_SOURCE_DIR}/Platform/${PAL_PLATFORM_NAME}")
endmacro()

