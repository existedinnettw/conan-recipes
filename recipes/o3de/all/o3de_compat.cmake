# cmake/FileUtil.cmake's ly_include_cmake_file_list: appends to ALLFILES in the caller's scope.
macro(o3de_include_file_list file)
  unset(FILES)
  unset(SKIP_UNITY_BUILD_INCLUSION_FILES)
  set(_o3de_list_file "${file}")
  cmake_path(ABSOLUTE_PATH _o3de_list_file BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
  include("${_o3de_list_file}")
  cmake_path(GET _o3de_list_file PARENT_PATH _o3de_list_dir)
  foreach(_o3de_f IN LISTS FILES SKIP_UNITY_BUILD_INCLUSION_FILES)
    cmake_path(ABSOLUTE_PATH _o3de_f BASE_DIRECTORY "${_o3de_list_dir}" NORMALIZE)
    list(APPEND ALLFILES "${_o3de_f}")
  endforeach()
endmacro()

function(ly_add_target)
  set(options STATIC SHARED MODULE GEM_STATIC GEM_MODULE GEM_SHARED OBJECT HEADERONLY EXECUTABLE
      APPLICATION IMPORTED AUTOMOC AUTOUIC AUTORCC NO_UNITY EXPORT_ALL_SYMBOLS)
  set(one_value NAME NAMESPACE OUTPUT_SUBDIRECTORY OUTPUT_NAME)
  set(multi_value FILES_CMAKE GENERATED_FILES INCLUDE_DIRECTORIES COMPILE_DEFINITIONS BUILD_DEPENDENCIES
      RUNTIME_DEPENDENCIES PLATFORM_INCLUDE_FILES TARGET_PROPERTIES AUTOGEN_RULES)
  cmake_parse_arguments(arg "${options}" "${one_value}" "${multi_value}" ${ARGN})
  # INTERFACE as the target type, not as the visibility in INCLUDE_DIRECTORIES and the like.
  cmake_parse_arguments(arg "INTERFACE" "" "" ${arg_UNPARSED_ARGUMENTS})

  set(name ${arg_NAME})
  if(arg_NAMESPACE)
    set(alias ${arg_NAMESPACE}::${name})
  else()
    set(alias ${name})
  endif()

  # Libraries, and the executables named in O3DE_EXECUTABLES.
  if(arg_IMPORTED OR ((arg_EXECUTABLE OR arg_APPLICATION) AND NOT name IN_LIST O3DE_EXECUTABLES))
    set_property(GLOBAL APPEND PROPERTY O3DE_SKIPPED_TARGETS ${alias})
    # A placeholder for the CMakeLists.txt that set properties on it afterwards (never built).
    if(NOT arg_IMPORTED AND NOT TARGET ${name})
      add_library(${name} INTERFACE)
    endif()
    return()
  endif()

  if(arg_GEM_STATIC)
    set(arg_STATIC TRUE)
  endif()
  if(arg_GEM_MODULE)
    set(arg_MODULE TRUE)
  endif()
  if(arg_GEM_SHARED)
    set(arg_SHARED TRUE)
  endif()
  if(arg_EXECUTABLE OR arg_APPLICATION)
    set(type EXECUTABLE)
  elseif(arg_HEADERONLY OR arg_INTERFACE)
    set(type INTERFACE)
  elseif(arg_OBJECT)
    set(type OBJECT)
  elseif(arg_STATIC)
    set(type STATIC)
  elseif(arg_SHARED OR arg_MODULE)
    # Libraries upstream always builds shared (AzQtComponents, AzToolsFramework, ...) carry their
    # own copy of the static framework libraries; a monolithic build links them statically.
    if(NOT BUILD_SHARED_LIBS)
      set(type STATIC)
    elseif(arg_MODULE)
      set(type MODULE)
    else()
      set(type SHARED)
    endif()
  else()
    message(FATAL_ERROR "ly_add_target(${name}): unknown target type")
  endif()

  set(ALLFILES)
  foreach(file_cmake IN LISTS arg_FILES_CMAKE)
    o3de_include_file_list("${file_cmake}")
  endforeach()

  # PLATFORM_INCLUDE_FILES set LY_* variables (cmake/LYWrappers.cmake's
  # ly_configure_target_platform_properties).
  set(platform_deps)
  set(platform_include_dirs)
  set(platform_defs)
  set(platform_options)
  set(platform_link_options)
  set(platform_properties)
  set(platform_runtime_deps)
  foreach(platform_file IN LISTS arg_PLATFORM_INCLUDE_FILES)
    foreach(var FILES_CMAKE FILES INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS
                BUILD_DEPENDENCIES RUNTIME_DEPENDENCIES TARGET_PROPERTIES)
      set(LY_${var})
    endforeach()
    include("${platform_file}")
    foreach(file_cmake IN LISTS LY_FILES_CMAKE)
      o3de_include_file_list("${file_cmake}")
    endforeach()
    list(APPEND ALLFILES ${LY_FILES})
    list(APPEND platform_deps ${LY_BUILD_DEPENDENCIES})
    list(APPEND platform_include_dirs ${LY_INCLUDE_DIRECTORIES})
    list(APPEND platform_defs ${LY_COMPILE_DEFINITIONS})
    list(APPEND platform_options ${LY_COMPILE_OPTIONS})
    list(APPEND platform_link_options ${LY_LINK_OPTIONS})
    list(APPEND platform_properties ${LY_TARGET_PROPERTIES})
    list(APPEND platform_runtime_deps ${LY_RUNTIME_DEPENDENCIES})
  endforeach()

  if(type STREQUAL "INTERFACE")
    add_library(${name} INTERFACE)
  else()
    # Only C/C++ sources and headers: the lists also name shaders, .ui/.qrc files (added
    # below for AUTOUIC/AUTORCC), jinja templates, ...
    set(sources ${ALLFILES} ${arg_GENERATED_FILES})
    list(FILTER sources INCLUDE REGEX "\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|inl|ui|qrc)$")
    if(NOT arg_AUTOUIC)
      list(FILTER sources EXCLUDE REGEX "\\.ui$")
    endif()
    if(NOT arg_AUTORCC)
      list(FILTER sources EXCLUDE REGEX "\\.qrc$")
    endif()
    if(type STREQUAL "EXECUTABLE")
      add_executable(${name} EXCLUDE_FROM_ALL ${sources})
    else()
      add_library(${name} ${type} EXCLUDE_FROM_ALL ${sources})
    endif()
    set_property(TARGET ${name} PROPERTY O3DE_ALLFILES ${ALLFILES})
    if(arg_GENERATED_FILES)
      set_source_files_properties(${arg_GENERATED_FILES} PROPERTIES GENERATED TRUE)
    endif()
    target_link_libraries(${name} PRIVATE o3de_config o3de_private)
    if(type STREQUAL "STATIC" OR type STREQUAL "OBJECT")
      set_target_properties(${name} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    endif()
    foreach(prop AUTOMOC AUTOUIC AUTORCC)
      if(arg_${prop})
        set_property(TARGET ${name} PROPERTY ${prop} ON)
      endif()
    endforeach()
    if(arg_AUTOMOC)
      set_property(TARGET ${name} PROPERTY AUTOMOC_PATH_PREFIX ON)
    endif()
  endif()
  if(NOT alias STREQUAL name)
    if(type STREQUAL "EXECUTABLE")
      add_executable(${alias} ALIAS ${name})
    else()
      add_library(${alias} ALIAS ${name})
    endif()
  endif()
  if(arg_OUTPUT_NAME)
    set_target_properties(${name} PROPERTIES OUTPUT_NAME ${arg_OUTPUT_NAME})
  endif()
  if(arg_INCLUDE_DIRECTORIES)
    target_include_directories(${name} ${arg_INCLUDE_DIRECTORIES})
  endif()
  if(platform_include_dirs)
    target_include_directories(${name} ${platform_include_dirs})
  endif()
  if(arg_COMPILE_DEFINITIONS)
    target_compile_definitions(${name} ${arg_COMPILE_DEFINITIONS})
  endif()
  if(platform_defs)
    target_compile_definitions(${name} ${platform_defs})
  endif()
  if(platform_options)
    target_compile_options(${name} ${platform_options})
  endif()
  if(platform_link_options)
    target_link_options(${name} ${platform_link_options})
  endif()
  if(arg_EXPORT_ALL_SYMBOLS AND NOT type STREQUAL "INTERFACE")
    target_compile_options(${name} PRIVATE ${PAL_TRAIT_EXPORT_ALL_SYMBOLS_COMPILE_OPTIONS})
  endif()
  if(arg_TARGET_PROPERTIES)
    set_target_properties(${name} PROPERTIES ${arg_TARGET_PROPERTIES})
  endif()
  if(platform_properties)
    set_target_properties(${name} PROPERTIES ${platform_properties})
  endif()
  # After the include directories: the generated headers mirror them.
  if(arg_AUTOUIC AND NOT type STREQUAL "INTERFACE")
    o3de_qt_uic_target(${name})
  endif()
  set_property(TARGET ${name} PROPERTY O3DE_DELAYED_LINK ${arg_BUILD_DEPENDENCIES} ${platform_deps})
  # The Gem modules an application loading this one loads too (SettingsRegistry.cmake)
  ly_add_dependencies(${name} ${arg_RUNTIME_DEPENDENCIES} ${platform_runtime_deps})
  set_property(TARGET ${name} PROPERTY O3DE_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  set_property(GLOBAL APPEND PROPERTY O3DE_TARGETS ${name})

  if(arg_AUTOGEN_RULES)
    o3de_add_autogen(${name} "${CMAKE_CURRENT_SOURCE_DIR}" "${arg_AUTOGEN_RULES}")
  endif()
endfunction()

# Upstream's Qt package's ly_qt_uic_target (FindQt.cmake): ui_<name>.h is generated in the folder
# of its .ui file relative to the target's source folder, under a generated folder that is added
# as an include directory, as is that folder relative to each of the target's include directories.
function(o3de_qt_uic_target target)
  get_target_property(sources ${target} SOURCES)
  set(ui_sources ${sources})
  list(FILTER ui_sources INCLUDE REGEX "\\.ui$")
  list(FILTER sources EXCLUDE REGEX "\\.ui$")
  set_target_properties(${target} PROPERTIES AUTOUIC OFF SOURCES "${sources}")
  set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/Azcg/Generated/${target}/uic")
  set(outputs)
  foreach(ui IN LISTS ui_sources)
    file(RELATIVE_PATH rel "${CMAKE_CURRENT_SOURCE_DIR}" "${ui}")
    cmake_path(GET rel PARENT_PATH rel_dir)
    cmake_path(GET ui STEM stem)
    set(out "${generated_dir}/${rel_dir}/ui_${stem}.h")
    add_custom_command(
      OUTPUT "${out}"
      COMMAND Qt5::uic -o "${out}" "${ui}"
      DEPENDS "${ui}"
      VERBATIM
    )
    list(APPEND outputs "${out}")
  endforeach()
  target_sources(${target} PRIVATE ${outputs})
  set_source_files_properties(${outputs} PROPERTIES SKIP_AUTOGEN ON)
  get_target_property(include_dirs ${target} INCLUDE_DIRECTORIES)
  set(generated_include_dirs "${generated_dir}")
  foreach(dir IN LISTS include_dirs)
    if(dir AND NOT dir MATCHES "\\$<" AND IS_ABSOLUTE "${dir}")
      file(RELATIVE_PATH dir "${CMAKE_CURRENT_SOURCE_DIR}" "${dir}")
      list(APPEND generated_include_dirs "${generated_dir}/${dir}")
    endif()
  endforeach()
  target_include_directories(${target} PRIVATE ${generated_include_dirs})
endfunction()

function(ly_create_alias)
  cmake_parse_arguments(arg "" "NAME;NAMESPACE" "TARGETS" ${ARGN})
  # Some callers pass the namespaced name (upstream's IMPORTED targets accept it).
  string(REGEX REPLACE "^${arg_NAMESPACE}::" "" arg_NAME "${arg_NAME}")
  if(TARGET ${arg_NAME})
    return()
  endif()
  add_library(${arg_NAME} INTERFACE)
  add_library(${arg_NAMESPACE}::${arg_NAME} ALIAS ${arg_NAME})
  set_property(TARGET ${arg_NAME} PROPERTY O3DE_DELAYED_LINK INTERFACE ${arg_TARGETS})
  set_property(TARGET ${arg_NAME} PROPERTY O3DE_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  set_property(GLOBAL APPEND PROPERTY O3DE_TARGETS ${arg_NAME})
endfunction()

function(ly_target_link_libraries target)
  if(TARGET ${target})
    set_property(TARGET ${target} APPEND PROPERTY O3DE_DELAYED_LINK ${ARGN})
  endif()
endfunction()

function(ly_add_source_properties)
  cmake_parse_arguments(arg "" "PROPERTY" "SOURCES;VALUES" ${ARGN})
  if(arg_VALUES)
    set_property(SOURCE ${arg_SOURCES} APPEND PROPERTY ${arg_PROPERTY} ${arg_VALUES})
  endif()
endfunction()

function(ly_target_include_system_directories)
  cmake_parse_arguments(arg "" "TARGET" "" ${ARGN})
  if(TARGET ${arg_TARGET})
    target_include_directories(${arg_TARGET} SYSTEM ${arg_UNPARSED_ARGUMENTS})
  endif()
endfunction()

# Runtime dependencies (upstream: add_dependencies, whose MANUALLY_ADDED_DEPENDENCIES
# SettingsRegistry.cmake follows to list the Gem modules to load), by name.
function(ly_add_dependencies target)
  string(REGEX REPLACE "^.*::" "" target "${target}")
  set_property(GLOBAL APPEND PROPERTY "O3DE_RUNTIME_DEPENDENCIES_${target}" ${ARGN})
endfunction()

# Files a target needs next to the executables at runtime (shader headers, ...): installed into
# bin/<OUTPUT_SUBDIRECTORY> with the target when O3DE_RUNTIME_FILES is on.
function(ly_add_target_files)
  cmake_parse_arguments(arg "" "OUTPUT_SUBDIRECTORY" "TARGETS;FILES" ${ARGN})
  # By name: PLATFORM_INCLUDE_FILES call it before ly_add_target creates the target.
  foreach(target IN LISTS arg_TARGETS)
    string(REGEX REPLACE "^.*::" "" target "${target}")
    foreach(file IN LISTS arg_FILES)
      set_property(GLOBAL APPEND PROPERTY "O3DE_TARGET_FILES_${target}" "${file}|${arg_OUTPUT_SUBDIRECTORY}")
    endforeach()
  endforeach()
endfunction()

# cmake/3rdParty.cmake's ly_add_external_target, for libraries vendored in the source tree.
function(ly_add_external_target)
  cmake_parse_arguments(arg "SYSTEM" "NAME;VERSION;PACKAGE;3RDPARTY_ROOT_DIRECTORY;3RDPARTY_DIRECTORY;OUTPUT_SUBDIRECTORY"
                        "INCLUDE_DIRECTORIES;COMPILE_DEFINITIONS;BUILD_DEPENDENCIES;RUNTIME_DEPENDENCIES;HEADER_CHECK" ${ARGN})
  set(base "${arg_3RDPARTY_ROOT_DIRECTORY}")
  if(arg_VERSION)
    set(base "${base}/${arg_VERSION}")
  endif()
  list(TRANSFORM arg_INCLUDE_DIRECTORIES PREPEND "${base}/")
  if(NOT TARGET 3rdParty::${arg_NAME})
    o3de_add_3rdparty(${arg_NAME} INCLUDE_DIRECTORIES ${arg_INCLUDE_DIRECTORIES}
                      COMPILE_DEFINITIONS ${arg_COMPILE_DEFINITIONS} TARGETS ${arg_BUILD_DEPENDENCIES})
  endif()
endfunction()

# Not needed for building libraries: tests, installers, runtime file copies, Python packages, ...
foreach(noop
    ly_add_googletest ly_add_googlebenchmark ly_add_pytest ly_install ly_install_directory
    ly_install_files ly_add_external_target_path ly_associate_package ly_set_gem_variant_to_load
    o3de_add_variant_dependencies_for_gem_dependencies o3de_fixup_fetchcontent_targets
    ly_pip_install_local_package_editable ly_add_editor_python_test ly_add_target_dependencies ly_add_translations)
  cmake_language(EVAL CODE "function(${noop})\nendfunction()")
endforeach()

# Resolves a dependency named in BUILD_DEPENDENCIES: "<name>" (a target or system library),
# or "" when it does not exist.
function(o3de_resolve_dependency item out)
  if(TARGET ${item})
    get_target_property(aliased ${item} ALIASED_TARGET)
    if(aliased)
      set(item ${aliased})
    endif()
    set(${out} ${item} PARENT_SCOPE)
  elseif(item MATCHES "::" OR item MATCHES "^(AUTOMOC|AUTOUIC|AUTORCC)$")
    set(${out} "" PARENT_SCOPE)
  else()
    set(${out} ${item} PARENT_SCOPE)
  endif()
endfunction()

# Walks O3DE_DELAYED_LINK and returns "<visibility>;<item>" pairs (flattened) in out_pairs and
# missing dependencies in out_missing.
function(o3de_target_dependencies target out_pairs out_missing)
  get_target_property(links ${target} O3DE_DELAYED_LINK)
  set(visibility PUBLIC)
  set(pairs)
  set(missing)
  foreach(item IN LISTS links)
    if(item MATCHES "^(PUBLIC|PRIVATE|INTERFACE)$")
      set(visibility ${item})
      continue()
    endif()
    o3de_resolve_dependency("${item}" resolved)
    if(NOT resolved)
      list(APPEND missing ${item})
    else()
      list(APPEND pairs ${visibility} ${resolved})
    endif()
  endforeach()
  set(${out_pairs} ${pairs} PARENT_SCOPE)
  set(${out_missing} ${missing} PARENT_SCOPE)
endfunction()

# Enables the buildable targets, links them, installs them and writes the components manifest.
function(o3de_finalize)
  get_property(targets GLOBAL PROPERTY O3DE_TARGETS)

  # Availability fixpoint: a target is available when all its dependencies are external
  # targets, system libraries or available O3DE targets.
  set(unavailable)
  foreach(target IN LISTS targets)
    o3de_target_dependencies(${target} pairs missing)
    if(missing)
      list(APPEND unavailable ${target})
      set_property(TARGET ${target} PROPERTY O3DE_MISSING "${missing}")
    endif()
  endforeach()
  set(changed TRUE)
  while(changed)
    set(changed FALSE)
    foreach(target IN LISTS targets)
      if(target IN_LIST unavailable)
        continue()
      endif()
      o3de_target_dependencies(${target} pairs missing)
      foreach(item IN LISTS pairs)
        if(item IN_LIST unavailable)
          list(APPEND unavailable ${target})
          set_property(TARGET ${target} PROPERTY O3DE_MISSING "${item}")
          set(changed TRUE)
          break()
        endif()
      endforeach()
    endforeach()
  endwhile()

  set(available)
  foreach(target IN LISTS targets)
    if(target IN_LIST unavailable)
      get_target_property(missing ${target} O3DE_MISSING)
      message(STATUS "O3DE: skipping ${target} (needs ${missing})")
    else()
      list(APPEND available ${target})
    endif()
  endforeach()
  get_property(skipped GLOBAL PROPERTY O3DE_SKIPPED_TARGETS)
  if(skipped)
    list(JOIN skipped ", " skipped)
    message(STATUS "O3DE: skipping executables ${skipped}")
  endif()

  # Every selected Gem must give something to link.
  get_property(selected_gems GLOBAL PROPERTY O3DE_SELECTED_GEMS)
  foreach(target IN LISTS available)
    get_target_property(dir ${target} O3DE_SOURCE_DIR)
    o3de_find_ancestor_gem_root(gem_root gem "${dir}")
    if(gem)
      set_property(GLOBAL PROPERTY "O3DE_GEM_HAS_TARGETS_${gem}" TRUE)
      set_property(TARGET ${target} PROPERTY O3DE_GEM "${gem}")
    endif()
  endforeach()
  foreach(gem IN LISTS O3DE_REQUESTED_GEMS)
    get_property(has_targets GLOBAL PROPERTY "O3DE_GEM_HAS_TARGETS_${gem}")
    get_property(gem_root GLOBAL PROPERTY "@GEMROOT:${gem}@")
    file(GLOB_RECURSE gem_cmake_lists "${gem_root}/*/CMakeLists.txt")
    if(NOT has_targets AND gem_cmake_lists)
      message(FATAL_ERROR "Gem ${gem} was requested, but none of its libraries can be built (see the skipped targets above)")
    endif()
  endforeach()

  # Link
  foreach(target IN LISTS available)
    get_target_property(type ${target} TYPE)
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
      set_target_properties(${target} PROPERTIES EXCLUDE_FROM_ALL FALSE)
    endif()
    o3de_target_dependencies(${target} pairs missing)
    while(pairs)
      list(POP_FRONT pairs visibility item)
      if(type STREQUAL "INTERFACE_LIBRARY")
        set(visibility INTERFACE)
      endif()
      if(TARGET ${item} AND NOT item MATCHES "::")
        get_target_property(item_type ${item} TYPE)
      else()
        set(item_type "")
      endif()
      if(item_type STREQUAL "MODULE_LIBRARY")
        # A module cannot be linked: use its usage requirements (LYWrappers.cmake).
        target_include_directories(${target} ${visibility} $<GENEX_EVAL:$<TARGET_PROPERTY:${item},INTERFACE_INCLUDE_DIRECTORIES>>)
        target_link_libraries(${target} ${visibility} $<GENEX_EVAL:$<TARGET_PROPERTY:${item},INTERFACE_LINK_LIBRARIES>>)
        target_compile_definitions(${target} ${visibility} $<GENEX_EVAL:$<TARGET_PROPERTY:${item},INTERFACE_COMPILE_DEFINITIONS>>)
        add_dependencies(${target} ${item})
      else()
        target_link_libraries(${target} ${visibility} ${item})
      endif()
    endwhile()
  endforeach()

  # Runtime files and executables
  foreach(target IN LISTS available)
    get_target_property(type ${target} TYPE)
    get_property(target_files GLOBAL PROPERTY "O3DE_TARGET_FILES_${target}")
    if(O3DE_RUNTIME_FILES AND target_files)
      foreach(target_file IN LISTS target_files)
        string(REGEX MATCH "^([^|]*)\\|(.*)$" unused "${target_file}")
        install(FILES "${CMAKE_MATCH_1}" DESTINATION "bin/${CMAKE_MATCH_2}")
      endforeach()
    endif()
    if(type STREQUAL "EXECUTABLE")
      install(TARGETS ${target} RUNTIME DESTINATION bin)
    endif()
  endforeach()
  if(O3DE_EXECUTABLES)
    if(O3DE_WITH_ASSET_PROCESSOR)
      o3de_generate_gem_registry("${available}" Builders "assetprocessor;assetprocessorbatch;assetbuilder"
                                 ${O3DE_EXTRA_BUILDER_TARGETS})
    endif()
    if(O3DE_WITH_LAUNCHER)
      # The launchers add the "client" specialization; AssetProcessor does not.
      o3de_generate_gem_registry("${available}" Clients "client" ${O3DE_EXTRA_CLIENT_TARGETS})
    endif()
  endif()

  # Install and describe the libraries
  set(manifest "{}")
  set(header_dirs)
  foreach(target IN LISTS available)
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "EXECUTABLE")
      continue()
    endif()
    o3de_component_name(${target} component)
    set(entry "{}")
    string(JSON entry SET "${entry}" type "\"${type}\"")
    o3de_target_alias(${target} alias)
    string(JSON entry SET "${entry}" target "\"${alias}\"")
    get_target_property(gem ${target} O3DE_GEM)
    if(gem)
      string(JSON entry SET "${entry}" gem "\"${gem}\"")
    endif()
    if(type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY)$")
      if(type STREQUAL "MODULE_LIBRARY")
        # Gem modules are loaded from the executables' folder.
        install(TARGETS ${target} LIBRARY DESTINATION bin)
      else()
        install(TARGETS ${target} ARCHIVE DESTINATION lib LIBRARY DESTINATION lib RUNTIME DESTINATION bin)
      endif()
      get_target_property(output_name ${target} OUTPUT_NAME)
      if(NOT output_name)
        set(output_name ${target})
      endif()
      string(JSON entry SET "${entry}" lib "\"${output_name}\"")
    endif()
    # Public include directories
    get_target_property(include_dirs ${target} INTERFACE_INCLUDE_DIRECTORIES)
    set(install_dirs "[]")
    foreach(dir IN LISTS include_dirs)
      # Autogen output directories are $<BUILD_INTERFACE:...>.
      if(dir MATCHES "^\\$<BUILD_INTERFACE:([^;>]*)>$")
        set(dir "${CMAKE_MATCH_1}")
      endif()
      if(NOT dir OR dir MATCHES "\\$<")
        continue()
      endif()
      o3de_install_include_dir("${dir}" install_dir)
      if(install_dir)
        list(APPEND header_dirs "${dir}")
        string(JSON n LENGTH "${install_dirs}")
        string(JSON install_dirs SET "${install_dirs}" ${n} "\"${install_dir}\"")
      endif()
    endforeach()
    string(JSON entry SET "${entry}" includedirs "${install_dirs}")
    # Public compile definitions, without generator expressions
    get_target_property(defs ${target} INTERFACE_COMPILE_DEFINITIONS)
    set(defines "[]")
    foreach(def IN LISTS defs)
      if(NOT def OR def MATCHES "\\$<")
        continue()
      endif()
      string(REPLACE "\\" "\\\\" def "${def}")
      string(REPLACE "\"" "\\\"" def "${def}")
      string(JSON n LENGTH "${defines}")
      string(JSON defines SET "${defines}" ${n} "\"${def}\"")
    endforeach()
    string(JSON entry SET "${entry}" defines "${defines}")
    # Requirements: O3DE components, Conan requirements and system libraries. A module is
    # loaded at runtime, not linked, so it only adds usage requirements.
    o3de_target_dependencies(${target} pairs missing)
    set(requires "[]")
    set(system_libs "[]")
    while(pairs)
      list(POP_FRONT pairs visibility item)
      if(TARGET ${item})
        get_target_property(conan_component ${item} O3DE_CONAN_COMPONENT)
        if(conan_component)
          set(names ${conan_component})
        elseif(item IN_LIST available)
          o3de_component_name(${item} names)
        else()
          set(names)
        endif()
        foreach(name IN LISTS names)
          string(JSON n LENGTH "${requires}")
          string(JSON requires SET "${requires}" ${n} "\"${name}\"")
        endforeach()
        get_target_property(vendored_includes ${item} O3DE_INSTALL_INCLUDES)
        foreach(dir IN LISTS vendored_includes)
          o3de_install_include_dir("${dir}" install_dir)
          if(install_dir)
            list(APPEND header_dirs "${dir}")
            string(JSON n LENGTH "${install_dirs}")
            string(JSON install_dirs SET "${install_dirs}" ${n} "\"${install_dir}\"")
          endif()
        endforeach()
        string(JSON entry SET "${entry}" includedirs "${install_dirs}")
      elseif(NOT item MATCHES "^-")
        string(JSON n LENGTH "${system_libs}")
        string(JSON system_libs SET "${system_libs}" ${n} "\"${item}\"")
      endif()
    endwhile()
    string(JSON entry SET "${entry}" requires "${requires}")
    string(JSON entry SET "${entry}" system_libs "${system_libs}")
    string(JSON manifest SET "${manifest}" "${component}" "${entry}")
  endforeach()
  list(REMOVE_DUPLICATES header_dirs)
  foreach(dir IN LISTS header_dirs)
    o3de_install_include_dir("${dir}" install_dir)
    install(DIRECTORY "${dir}/" DESTINATION "${install_dir}"
            FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp" PATTERN "*.hxx" PATTERN "*.inl")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/o3de-components.json" "${manifest}\n")
  install(FILES "${CMAKE_BINARY_DIR}/o3de-components.json" DESTINATION res)
endfunction()

# cmake/SettingsRegistry.cmake's ly_delayed_generate_settings_registry, for a variant (Builders,
# Clients, ...) of the selected Gems and the extra targets passed:
# bin/Registry/cmake_dependencies.<specialization>.setreg lists the Gem modules the executables
# with that settings registry specialization load. Without a project prefix, it applies to every
# project.
function(o3de_generate_gem_registry available variant specializations)
  get_property(selected_gems GLOBAL PROPERTY O3DE_SELECTED_GEMS)
  set(queue)
  foreach(gem IN LISTS selected_gems)
    list(APPEND queue "${gem}.${variant}")
  endforeach()
  # "A|B": the first of these that is available. A fallback (B) is loaded without its runtime
  # dependencies: those are the runtime modules of other Gems, whose editor modules register the
  # same components (two descriptors of a component crash on unload).
  set(no_runtime_dependencies)
  foreach(extra IN LISTS ARGN)
    string(REPLACE "|" ";" alternatives "${extra}")
    list(GET alternatives 0 preferred)
    foreach(alternative IN LISTS alternatives)
      if(alternative IN_LIST available)
        list(APPEND queue ${alternative})
        if(NOT alternative STREQUAL preferred)
          list(APPEND no_runtime_dependencies ${alternative})
        endif()
        break()
      endif()
    endforeach()
  endforeach()
  # The modules these stand for, through aliases and runtime dependencies
  set(modules)
  set(seen)
  while(queue)
    list(POP_FRONT queue item)
    string(REGEX REPLACE "^.*::" "" item "${item}")
    if(item IN_LIST seen OR NOT item IN_LIST available)
      continue()
    endif()
    list(APPEND seen ${item})
    get_target_property(type ${item} TYPE)
    if(type STREQUAL "MODULE_LIBRARY")
      list(APPEND modules ${item})
    endif()
    if(type STREQUAL "INTERFACE_LIBRARY")
      o3de_target_dependencies(${item} pairs missing)
      while(pairs)
        list(POP_FRONT pairs visibility dep)
        list(APPEND queue ${dep})
      endwhile()
    endif()
    if(NOT item IN_LIST no_runtime_dependencies)
      get_property(runtime_deps GLOBAL PROPERTY "O3DE_RUNTIME_DEPENDENCIES_${item}")
      list(APPEND queue ${runtime_deps})
    endif()
  endwhile()
  set(gems_json "{}")
  foreach(module IN LISTS modules)
    get_target_property(module_gem ${module} O3DE_GEM)
    get_target_property(output_name ${module} OUTPUT_NAME)
    if(NOT output_name)
      set(output_name ${module})
    endif()
    string(JSON has_gem ERROR_VARIABLE err GET "${gems_json}" "${module_gem}")
    if(err)
      string(JSON gems_json SET "${gems_json}" "${module_gem}" "{\"Targets\": {}}")
    endif()
    string(JSON gems_json SET "${gems_json}" "${module_gem}" Targets "${module}"
           "{\"Modules\": [\"lib${output_name}.so\"]}")
  endforeach()
  set(setreg "{\"O3DE\": {\"Gems\": ${gems_json}}}")
  foreach(specialization IN LISTS specializations)
    set(file "${CMAKE_BINARY_DIR}/Registry/cmake_dependencies.${specialization}.setreg")
    file(WRITE "${file}" "${setreg}\n")
    install(FILES "${file}" DESTINATION bin/Registry)
  endforeach()
endfunction()

# The namespaced name of an O3DE target, e.g. Gem::Atom_RPI.Public for Atom_RPI.Public.
function(o3de_target_alias target out)
  set(${out} ${target} PARENT_SCOPE)
  foreach(namespace AZ Gem Legacy)
    if(TARGET ${namespace}::${target})
      set(${out} ${namespace}::${target} PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

# Conan component of an O3DE target: its target name with the namespace, e.g. Gem::Atom_RPI.Public
# is "Gem_Atom_RPI.Public".
function(o3de_component_name target out)
  o3de_target_alias(${target} alias)
  string(REPLACE "::" "_" name "${alias}")
  set(${out} "${name}" PARENT_SCOPE)
endfunction()

# Where a source include directory is installed: include/O3DE/<path in the O3DE tree>, or
# include/O3DE/<path in the build tree> for generated headers.
function(o3de_install_include_dir dir out)
  cmake_path(NORMAL_PATH dir)
  string(REGEX REPLACE "/$" "" dir "${dir}")
  cmake_path(IS_PREFIX O3DE_ROOT "${dir}" NORMALIZE in_source)
  cmake_path(IS_PREFIX CMAKE_BINARY_DIR "${dir}" NORMALIZE in_build)
  if(in_source)
    file(RELATIVE_PATH rel "${O3DE_ROOT}" "${dir}")
  elseif(in_build)
    file(RELATIVE_PATH rel "${CMAKE_BINARY_DIR}" "${dir}")
    set(rel "Generated/${rel}")
  else()
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  if(rel STREQUAL "")
    set(${out} "include/O3DE/Engine" PARENT_SCOPE)
  else()
    set(${out} "include/O3DE/Engine/${rel}" PARENT_SCOPE)
  endif()
endfunction()
