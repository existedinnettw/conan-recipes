 #include "sapien/logger.h"
 #include <spdlog/sinks/stdout_color_sinks.h>
 #include <spdlog/spdlog.h>
+#include <type_traits>
 
 namespace sapien {
 namespace logger {
 
 std::shared_ptr<spdlog::logger> getLogger();
 
+// spdlog 1.8 (upstream's pin) took run-time format strings and printed plain enums as
+// integers; newer spdlog/fmt check format strings at compile time and need a formatter
+// for every enum.
+template <typename T> inline decltype(auto) fmtArg(const T &arg) {
+  if constexpr (std::is_enum_v<T> && !fmt::is_formattable<T>::value) {
+    return fmt::underlying(arg);
+  } else {
+    return (arg);
+  }
+}
+
 template <typename... Args> inline void debug(spdlog::string_view_t fmt, const Args &...args) {
-  getLogger()->debug(fmt, args...);
+  getLogger()->debug(fmt::runtime(fmt), fmtArg(args)...);
 };
 
 template <typename... Args> inline void info(spdlog::string_view_t fmt, const Args &...args) {
-  getLogger()->info(fmt, args...);
+  getLogger()->info(fmt::runtime(fmt), fmtArg(args)...);
 };
 
